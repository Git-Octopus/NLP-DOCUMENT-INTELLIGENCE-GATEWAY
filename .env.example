# Gateway Application
APP_NAME="NLP Document Intelligence Gateway"
APP_VERSION="0.1.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Vector Database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
TOPICS_COLLECTION="support_topics"
MESSAGES_COLLECTION="support_messages"

# Decision Thresholds
TOPIC_CONFIDENCE_THRESHOLD=0.70
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# Fallback LLM Providers (Optional for local-only NLP testing)
PRIMARY_LLM_PROVIDER="gemini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Database
DATABASE_URL="sqlite:///./nlp_gateway.db"
