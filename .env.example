# Gateway Application
APP_NAME="NLP Document Intelligence Gateway"
APP_VERSION="1.0.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Vector Database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
# changed: collection names matching app/config.py
TOPICS_COLLECTION="topics"
MESSAGES_COLLECTION="messages"
QDRANT_COLLECTION_TOPICS="topics"
QDRANT_COLLECTION_MESSAGES="messages"

# Decision Thresholds
# confidence threshold aligned with app/config.py
TOPIC_CONFIDENCE_THRESHOLD=0.58
SIMILARITY_THRESHOLD=0.58
DUPLICATE_SIMILARITY_THRESHOLD=0.85
DUPLICATE_THRESHOLD=0.85

# File Size Limit (10 MB)
MAX_FILE_SIZE_BYTES=10485760

# Fallback LLM Providers (Optional for local-only NLP testing)
PRIMARY_LLM_PROVIDER="gemini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Database

DATABASE_URL="sqlite:///./nlp_gateway.db"
